{{/* Discord notification templates, shared by the edge Alertmanager (this
     copy, every cluster) and luxor's central one
     (flux/apps/luxor/monitoring/templates/discord.tmpl — keep the two
     files identical; CI's plain `kustomize build` can't follow a
     cross-directory reference).

     Wired in by the alertmanager.yaml sops secret:
       templates: [/etc/alertmanager/configmaps/alertmanager-templates/discord.tmpl]
       discord_configs[].title/message/content → sfi.discord.{title,message,content}

     Design: the first line is "[STATUS] AlertName: summary" — the alert's
     meaning, nothing else — because that is what a notification summarizer
     (and a human on a phone) reads. The body is one block per alert:
     summary, cluster, severity, timing, then a Thanos query link anchored
     on StartsAt and a Grafana link with the same window. Labels are
     deliberately NOT dumped: the summary annotation already names the
     affected object, and the query link carries the full label set. */}}

{{ define "sfi.alertname" }}{{ or .GroupLabels.alertname .CommonLabels.alertname "alerts" }}{{ end }}

{{/* The alerts this notification is about: the firing ones while anything
     is still firing, otherwise the resolved batch. Groups are per
     alertname+cluster, so a multi-alert headline names the cluster and
     leaves the per-resource summaries to the body. */}}
{{ define "sfi.headline" -}}
{{- $alerts := .Alerts.Firing }}{{ if eq .Status "resolved" }}{{ $alerts = .Alerts.Resolved }}{{ end -}}
[{{ .Status | toUpper }}{{ if gt (len $alerts) 1 }}:{{ len $alerts }}{{ end }}] {{ template "sfi.alertname" . }}: {{ if eq (len $alerts) 1 }}{{ (index $alerts 0).Annotations.summary }}{{ else }}{{ len $alerts }} alerts{{ with .CommonLabels.cluster }} on {{ . }}{{ end }}{{ end }}
{{- end }}

{{/* title = embed title; content = the plain message line above the embed,
     which is what Discord's push notification carries. */}}
{{ define "sfi.discord.title" }}{{ template "sfi.headline" . }}{{ end }}
{{ define "sfi.discord.content" }}{{ template "sfi.headline" . }}{{ end }}

{{/* GeneratorURL is the evaluating Prometheus/Ruler's own /graph?g0.expr=…
     link (edge: mesh NodePort, table tab; ThanosRuler: alertQueryUrl).
     Re-home it on thanos-query, switch to the graph tab and anchor a 1h
     window centred on StartsAt (end_input is the Prometheus-UI "YYYY-MM-DD
     HH:mm:ss" UTC form). Durations are text/template integer literals in
     nanoseconds because the template language has no arithmetic. */}}
{{ define "sfi.link.query" -}}
https://query.luxor.lofi/graph?{{ .GeneratorURL | reReplaceAll "^[^?]*\\?" "" | reReplaceAll "g0\\.tab=1" "g0.tab=0" }}&g0.range_input=1h&g0.end_input={{ (.StartsAt.Add 1800000000000).UTC.Format "2006-01-02 15:04:05" | urlquery }}
{{- end }}

{{/* Fleet overview dashboard, StartsAt-30m .. (EndsAt|StartsAt)+30m.
     Grafana takes epoch milliseconds; Unix seconds + "000". */}}
{{ define "sfi.link.grafana" -}}
https://grafana.luxor.lofi/d/sfi-fleet-overview?from={{ (.StartsAt.Add -1800000000000).Unix }}000&to={{ if eq .Status "resolved" }}{{ (.EndsAt.Add 1800000000000).Unix }}000{{ else }}{{ (.StartsAt.Add 1800000000000).Unix }}000{{ end }}
{{- end }}

{{ define "sfi.discord.alert" -}}
{{ if eq .Status "firing" }}🔴{{ else }}🟢{{ end }} **{{ .Annotations.summary }}**
{{- with .Annotations.description }}
{{ . }}{{ end }}
{{ with .Labels.cluster }}`{{ . }}` · {{ end }}{{ with .Labels.severity }}{{ . }} · {{ end }}{{ if eq .Status "firing" }}since {{ .StartsAt.UTC.Format "15:04 UTC" }} ({{ since .StartsAt | humanizeDuration }}){{ else }}{{ .StartsAt.UTC.Format "15:04" }}–{{ .EndsAt.UTC.Format "15:04 UTC" }} ({{ .EndsAt.Sub .StartsAt | humanizeDuration }}){{ end }}
[query]({{ template "sfi.link.query" . }}) · [grafana]({{ template "sfi.link.grafana" . }})
{{ end }}

{{ define "sfi.discord.message" -}}
{{ range .Alerts.Firing }}{{ template "sfi.discord.alert" . }}{{ end -}}
{{ range .Alerts.Resolved }}{{ template "sfi.discord.alert" . }}{{ end -}}
{{ end }}
