# sops-nix wiring for cloud-fort: decrypts secrets/cloud-fort.yaml
# with the age key derived from this host's SSH ed25519 host key
# (minted by fort mint and placed by the initrd from the Linode Metadata
# channel before activation (modules/runtime/seed.nix, #606) — the host never
# generates its own). k3s-token is
# declared by modules/k3s-server.nix; wireguard-private-key (declared
# below) is consumed by modules/wireguard.nix. deployer-password-hash is
# declared by modules/ops/console.nix, which the host file enables.
#
# GENERATED by `fort scaffold cloud-fort` (only when absent).
{ ... }:

{
  sops = {
    defaultSopsFile = ../../secrets/cloud-fort.yaml;
    age.sshKeyPaths = [ "/etc/ssh/ssh_host_ed25519_key" ];

    secrets.wireguard-private-key = {
      mode = "0400";
      owner = "root";
    };
  };
}
