# Seeding contract — NON-SECRET; `fort seed` executes it.
#
# PRE-`fort seed` FULL FORM, rendered by `fort add` from the chart's own
# forts.contract.yaml ({{ .ChartRepo }} {{ .Version }}). The chart's copy is
# the contract; this file is what the current python seeder needs to
# produce the Secret, and it shrinks to nothing once the CLI reads the
# chart's copy (docs/fort-configuration-contracts.md). Key set = the chart contract's
# `secret.keys`; provider passwords resolve to the fort's provider
# secrets by convention (lockstep pairs on rotation). `external` keys
# stay ABSENT from the Secret until a human sets them — replace with a
# sops/env ref (a source the seeder can read) or `sops set` the value
# after seeding.
{{- if .Vars }}
vars:
{{- range .Vars }}
  # {{ .Comment }}
  {{ .Name }}: {sops: [{{ .File }}, {{ .Path }}]}
{{- end }}
{{- end }}
secrets:
  secrets.sops.yaml:
    metadata:
      name: {{ .SecretName }}
      namespace: {{ .App }}
    keys:
{{- range .Keys }}
      {{ .Name }}: {{ .Spec.YAML }}
{{- end }}
