# Scrape wiring for {{ .App }}'s {{ .Component }} metrics, as `fort add` renders it
# from the chart contract's metrics block (port `{{ .Metrics.Port }}`, component
# {{ .Component }}). Scraped by the edge Prometheus (podMonitorSelector {}),
# remote-written centrally like everything else. Alert rules are
# fort-side policy, not chart facts — add them by hand (staging-k3s's
# monitoring.yaml has the set) when this fort's {{ .App }} should page.
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: {{ .App }}-{{ .Component }}
  namespace: {{ .App }}
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ .App }}
{{- range .SelectorLines }}
      {{ . }}
{{- end }}
  podMetricsEndpoints:
    - port: {{ .Metrics.Port }}
