{{ if .NoContract -}}
# {{ .App }} — HelmRelease rendered by `fort add`. The chart ships no
# contract, so there is nothing to wire and no Secret key here:
# `values` stays empty. Retry forever: the first install
{{ else -}}
# {{ .App }} — HelmRelease rendered by `fort add` from the chart's contract:
{{ if .ValuesYAML }}# the `wire:` values paths are filled from the fort's providers by
# convention{{ if .Postgres }} (postgres → the shared sites-db, tenant `{{ .App }}`){{ end }}{{ if .Valkey }}{{ if .Postgres }};{{ end }}
# (valkey → the shared valkey, ACL user `{{ .App }}`, db{{ .Valkey.DB }}){{ end }}{{ if .S3 }}{{ if or .Postgres .Valkey }};{{ end }}
# (s3 → the shared rustfs, bucket and identity `{{ .App }}`){{ end }}; {{ if .HasSecret }}password-class
# keys ride the {{ .SecretName }} Secret{{ else }}the contract declares no
# Secret key{{ end }}. Retry forever: the first install
{{ else }}# the contract names no provider to wire and no Secret key, so
# `values` stays empty. Retry forever: the first install
{{ end }}{{ end -}}
# races its providers (and a preview pin races the images) — never park
# on a failed release waiting for an ops nudge. Refine in place after
# add: replicas for the node shape, non-secret env as values (never in
# the Secret — a values change rolls pods), app-specific knobs.
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: {{ .App }}
  namespace: {{ .App }}
spec:
  interval: 1h
  releaseName: {{ .App }}
  chartRef:
    kind: OCIRepository
    name: {{ .App }}
    namespace: flux-system
  install:
    remediation:
      retries: -1
  upgrade:
    remediation:
      retries: -1
{{- if .ValuesYAML }}
  values:
{{ .ValuesYAML }}
{{- end }}
