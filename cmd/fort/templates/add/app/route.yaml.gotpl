# HTTPRoute for {{ .App }}, as `fort add` renders it from the chart
# contract's http block ({{ .HTTP.Service }}:{{ .HTTP.Port }}) and the fort's hostname
# convention; attaches to the listener added by
# ../gateway/listener-{{ .App }}.yaml.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ .App }}
  namespace: {{ .App }}
spec:
  parentRefs:
    - name: homelab
      namespace: traefik
      sectionName: https-{{ .App }}
  hostnames:
    - {{ .Hostname }}
  rules:
    - backendRefs:
        - name: {{ .HTTP.Service }}
          port: {{ .HTTP.Port }}
