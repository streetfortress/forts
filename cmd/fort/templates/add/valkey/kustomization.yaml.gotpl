apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - repository.yaml
  - release.yaml
  - monitoring.yaml
  # Secret valkey-users (key per ACL user: default + {{ .App }}), seeded
  # from forts.contract.yaml; listed-but-absent = the pre-merge
  # kustomize guard.
  - secrets.sops.yaml
{{ .ValkeyPatchesComment -}}
patches:
  - path: acl-{{ .App }}.yaml
    target:
      group: helm.toolkit.fluxcd.io
      version: v2
      kind: HelmRelease
      name: valkey
      namespace: forts
