# Serving cert for the https-{{ .App }} listener; issued by the estate's
# ClusterIssuer `{{ .Issuer }}` ({{ .ACMEDirectory }}) via the ACME http01
# gateway solver. Gated on DNS: until {{ .Hostname }} resolves to this
# fort where the ACME server looks, cert-manager retries harmlessly and
# the listener serves its self-signed placeholder.
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ .App }}
  namespace: traefik
spec:
  secretName: {{ .App }}-tls
  dnsNames:
    - {{ .Hostname }}
  issuerRef:
    kind: ClusterIssuer
    name: {{ .Issuer }}
