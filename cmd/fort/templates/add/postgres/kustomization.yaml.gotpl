apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - cluster.yaml
{{- if .Archive }}
  - objectstore.yaml
  - scheduled-backup.yaml
{{- end }}
  - database-{{ .App }}.yaml
{{- if .Archive }}
  # Seeded from forts.contract.yaml (secrets-backup carries the fort's
  # own B2 key for the barman archive, objectstore.yaml; secrets-<app>
  # each tenant's role password); listed-but-absent = the pre-merge
  # kustomize guard.
  - secrets-backup.sops.yaml
{{- else }}
  # Seeded from forts.contract.yaml (secrets-<app>: each tenant's role
  # password); listed-but-absent = the pre-merge kustomize guard. No
  # secrets-backup: this fort's profile renders no archive (cluster.yaml).
{{- end }}
  - secrets-{{ .App }}.sops.yaml
{{ .PostgresPatchesComment -}}
patches:
  - path: role-{{ .App }}.yaml
    target:
      group: postgresql.cnpg.io
      version: v1
      kind: Cluster
      name: postgres
      namespace: forts
