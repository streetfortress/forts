# {{ .App }}'s login role on the fort's postgres — appended to
# managed.roles by the patch entry in kustomization.yaml; the password
# is postgres-{{ .App }}-credentials (secrets-{{ .App }}.sops.yaml).
- op: add
  path: /spec/managed/roles/-
  value:
    name: {{ .App }}
    ensure: present
    login: true
    passwordSecret:
      name: postgres-{{ .App }}-credentials
