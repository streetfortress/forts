# {{ .App }}'s login role on the shared sites-db cluster — appended to
# managed.roles by the patch entry in kustomization.yaml; the password
# is sites-db-{{ .App }}-credentials (secrets-{{ .App }}.sops.yaml).
- op: add
  path: /spec/managed/roles/-
  value:
    name: {{ .App }}
    ensure: present
    login: true
    passwordSecret:
      name: sites-db-{{ .App }}-credentials
