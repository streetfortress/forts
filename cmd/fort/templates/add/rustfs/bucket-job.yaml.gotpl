# One-shot Job that creates buckets — rustfs does not auto-create them.
# One line per app on this fort, bucket = <app> with no fort prefix
# (docs/infra/backups.md, "Fort-local rustfs": the instance is already the
# scope, and a generated fort name in the bucket would churn every app's
# config on a rebirth). `fort add` appends a line here when a later app
# requires s3; `rc bucket create` never deletes, so a bucket outlives its
# line until removed by hand — the Job only guarantees what IS listed
# exists. `--ignore-existing` makes it idempotent. No
# ttlSecondsAfterFinished: flux would recreate (and re-run) the Job every
# reconcile once it was GC'd. Jobs are immutable, so the force annotation
# lets flux delete+recreate (and re-run) it when the spec changes — the
# value must be "Enabled", flux does not recognize "true" (luxor, #98).
apiVersion: batch/v1
kind: Job
metadata:
  name: rustfs-bucket-init
  namespace: forts
  annotations:
    kustomize.toolkit.fluxcd.io/force: Enabled
spec:
  backoffLimit: 10
  template:
    spec:
      restartPolicy: OnFailure
      containers:
        - name: rc
          # rc, rustfs's own client, on the fleet's job-runner image
          # (sfi/action-runner-image job-runner/), pinned by sha so a
          # moved tag cannot take the Job out (#614, #98).
          image: gitea.zen.lofi/sfi/job-runner:9dd44f4
          envFrom:
            - secretRef:
                name: rustfs-credentials
          command: ["sh", "-c"]
          args:
            - |
              until rc alias set r http://rustfs-svc:9000 "$RUSTFS_ACCESS_KEY" "$RUSTFS_SECRET_KEY" >/dev/null; do
                echo "waiting for rustfs-svc..."; sleep 2
              done
              rc bucket create --ignore-existing r/{{ .App }}
              rc ls r
