# {{ .Hostname }}'s per-cluster monitoring for the hub (#288, forts#38) —
# rendered by `fort scaffold` from the manifest (mesh_ip, [[backups.pv]])
# into flux/hub/{{ .HubHost }}/ of this estate, removed by `fort dismantle`;
# `fort check --all` requires one per flux cluster. The hub subscribes
# to the directory with flux. Everything the central layer has to know
# about ONE cluster lives here, so no fort is configured outside its own
# -keyed paths and nothing is written into the hub's tree: the dead man's
# switch for its metrics stream, the log analog, the backup leg its
# pv blocks promise, and its edge Alertmanager as a Grafana datasource.
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: cluster-{{ .Hostname }}
  namespace: monitoring-central
  labels:
    monitoring.sfi/scope: central
spec:
  groups:
    - name: cluster-{{ .Hostname }}
      rules:
        # absent(): when an edge stops remote-writing, its series go
        # stale and vanish — an expression over the missing data cannot
        # fire, only absent() can. It keys on cluster alone: absent()
        # has no by clause, and the fort's name is the identity. The
        # alert carries the estate's name as a label (forts#50) so the
        # hub's Alertmanager can route or group a silent fort by estate.
        - alert: ClusterStreamSilent
          expr: absent(up{cluster="{{ .Hostname }}"})
          for: 10m
          labels:
            severity: critical
            cluster: {{ .Hostname }}
            estate: {{ .Estate }}
          annotations:
            summary: "No data from {{ .Hostname }}'s edge Prometheus"
{{- if .PV }}
        # [[backups.pv]] blocks: the host imports sfi.pv-backup (fort
        # scaffold), so a fort that declares a pv leg and publishes no
        # pv-backup metrics is a manifest/host disagreement. The unit-side
        # rules in rules-edge.yaml can only judge series that exist (#323).
        # No pv block, no rule: a fort whose backups are the db layers
        # alone (the production fort) has nothing here to be silent about.
        - alert: PVBackupNotConfigured
          expr: absent(node_pv_backup_paths{cluster="{{ .Hostname }}"})
          for: 1h
          labels:
            severity: warning
            cluster: {{ .Hostname }}
            estate: {{ .Estate }}
          annotations:
            summary: "{{ .Hostname }} declares [[backups.pv]] blocks ({{ range $i, $p := .PV }}{{ if $i }}, {{ end }}{{ $p.Store }}{{ end }}) but publishes no pv-backup metrics — sfi.pv-backup not enabled on the host?"
{{- end }}
---
# Log analog of the dead man's switch, synced into the Loki ruler by the
# chart's rules sidecar (any ConfigMap labeled loki_rule). Warning: the
# metrics switch is the critical cluster-down page; this one says "logs
# broke" as distinct from "cluster broke".
apiVersion: v1
kind: ConfigMap
metadata:
  name: loki-rules-{{ .Hostname }}
  namespace: monitoring-central
  labels:
    loki_rule: "1"
data:
  {{ .Hostname }}.yaml: |
    groups:
      - name: cluster-{{ .Hostname }}
        rules:
          - alert: LogStreamSilent
            expr: absent_over_time({job="fluent-bit", cluster="{{ .Hostname }}"}[15m])
            for: 5m
            labels:
              severity: warning
              cluster: {{ .Hostname }}
              estate: {{ .Estate }}
            annotations:
              summary: No container logs from {{ .Hostname }} for 15m — fluent-bit or Loki ingest broken
---
# The cluster's edge Alertmanager as a Grafana datasource (the
# datasources sidecar: any ConfigMap labeled grafana_datasource), so
# Grafana's Alerting → Silences page is the single pane for silences
# across the fleet. Silences are PER-AM: an alert firing from three edges
# needs three silences.
{{- if .Hub }}
# The hub's own edge, via cluster DNS.
{{- else }}
# Over the mesh: the #137 NodePort; grafana's pod egress rides the hub's
# mesh interface (its own, or its link to this estate).
{{- end }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasource-{{ .Hostname }}
  namespace: monitoring-central
  labels:
    grafana_datasource: "1"
data:
  alertmanager-{{ .Hostname }}.yaml: |
    apiVersion: 1
    datasources:
      - name: Alertmanager Edge ({{ .Hostname }})
        type: alertmanager
        uid: am-edge-{{ .Hostname }}
        url: {{ if .Hub }}http://alertmanager-operated.monitoring.svc.cluster.local:9093{{ else }}http://{{ .MeshIP }}:30993{{ end }}
        jsonData:
          implementation: prometheus
