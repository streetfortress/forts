# The estates {{ .Hostname }} serves the monitoring role (forts#38): one
# subscription per estate — this estate's own when {{ .Hostname }} is its
# [hubs.monitoring], and every estate its [[serves.monitoring]] entry in
# estate.toml lists. Rendered by `fort scaffold
# {{ .Hostname }}`; a new entry re-runs it, and the line is appended
# here. `fort check --all` requires one file per entry and no file
# without one.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
{{- range .Serves }}
  - {{ .Name }}.yaml
{{- end }}
