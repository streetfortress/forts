# {{ .Hostname }}'s monitoring for the hub — a PLAIN fort (no [cluster]):
# no edge Prometheus, so the hub PULLS. Rendered by `fort scaffold` from
# the manifest (mesh_ip) into flux/hub/{{ .HubHost }}/ of this estate
# (forts#38), removed by `fort dismantle`; `fort check --all` requires
# one per plain fort. One target over the mesh: node-exporter
# (lab-host.nix). This file arms the switch on it. `cluster` = the fort's
# name — a cluster of none, but the label every fleet rule and dashboard
# keys on. Anything else the estate runs on the fort is the estate's to
# scrape, in its own file beside this one.
#
# `job` is the CR's: the operator relabels job to spec.jobName AFTER the
# target's own labels are merged, so a `job:` under staticConfigs never
# survives (#442). The leg is job="host-node-exporter", the name a cluster
# fort's edge ServiceMonitor gives the same exporter: that job is the Host
# Overview dashboard's $host list and every panel on it (host-fleet.py),
# so the fort shows up there the moment the hub scrapes it. `component`
# is what the switch keys on; `instance` = the hostname, as on a cluster
# fort (dashboards key on names, not mesh IP:port pairs). `estate` is
# the estate's name (forts#50): a cluster fort's edge Prometheus stamps
# it as an external label on every series it pushes; a pulled target
# has no edge, so the hub stamps it here, and the hub groups plain and
# cluster forts by estate alike.
apiVersion: monitoring.coreos.com/v1alpha1
kind: ScrapeConfig
metadata:
  name: host-{{ .Hostname }}-node
  namespace: monitoring-central
  labels:
    monitoring.sfi/scope: central
spec:
  jobName: host-node-exporter
  staticConfigs:
    - targets: ["{{ .MeshIP }}:9100"]
      labels:
        component: node
        instance: {{ .Hostname }}
        cluster: {{ .Hostname }}
        estate: {{ .Estate }}
        host: {{ .Hostname }}
---
# Dead man's switch, pull-shaped: a scraped target that stops answering
# is up == 0 (no absent() needed — the series lives as long as this file).
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: host-{{ .Hostname }}
  namespace: monitoring-central
  labels:
    monitoring.sfi/scope: central
spec:
  groups:
    - name: host-{{ .Hostname }}
      rules:
        - alert: HostDown
          expr: up{cluster="{{ .Hostname }}", component="node"} == 0
          for: 10m
          labels:
            severity: critical
            cluster: {{ .Hostname }}
            estate: {{ .Estate }}
          annotations:
            summary: "{{ .Hostname }} unreachable over the mesh for 10m — fort down, or destroyed without `fort dismantle {{ .Hostname }}`"
