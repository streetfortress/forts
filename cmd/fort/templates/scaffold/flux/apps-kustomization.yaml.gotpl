apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  # sops-canary.yaml is generated by fort mint (encrypted to
  # the cluster's fresh age key); listing it missing keeps `kustomize
  # build` failing until identity exists — the repo's established
  # pre-merge guard. `fort add` appends the workloads below it.
  - sops-canary.yaml
{{- if .IsHub }}
  # This fort is a monitoring hub (estate.toml [hubs.monitoring] or a
  # [[serves.monitoring]] entry, forts#38): serves/ holds one flux
  # subscription per estate it serves.
  - serves
{{- end }}
