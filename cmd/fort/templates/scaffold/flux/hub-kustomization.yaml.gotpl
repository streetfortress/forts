# What this estate asks of its monitoring hub, {{ .HubHost }} (forts#38):
# one file per fort — rendered by `fort scaffold` into this directory,
# removed by `fort dismantle`, required by `fort check --all`. The hub
# subscribes to this path with flux (its serves/ directory holds the
# Kustomization), under a service account that can write PrometheusRule,
# ScrapeConfig and ConfigMap in monitoring-central and nothing else; a
# fort dismantled here leaves the hub by prune. Nothing in this
# directory is applied by this estate's own clusters{{ if .HubLocal }} except through
# the hub's subscription to it{{ end }}.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - {{ .Hostname }}.yaml
