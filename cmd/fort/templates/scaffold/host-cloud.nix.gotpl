# {{ .Hostname }} — single-node k3s on a {{ .Provider }} VPS ({{ .Region }},
# {{ .InstanceType }}).
#
# GENERATED by `fort scaffold {{ .Hostname }}` from its manifest,
# forts/{{ .Hostname }}.toml. Scaffolding never overwrites this
# file — the manifest seeds the host, you refine it here.
#
# Built as a Linode image via the upstream framework (#95/#42) — the flake
# exposes it as `{{ .Hostname }}-linode` (the runtime-linode import below
# says which variant). Root filesystem, bootloader (GRUB + LISH serial),
# eth0 DHCP, and swap on /dev/sdb all come from upstream's linode-config.nix
# via modules/runtime/linode.nix — no hand-written hardware.nix and no
# static-LAN block.
#
# HARDENED (every fort, modules/hardened.nix): SSH answers on the
# wireguard mesh address ONLY — reach it as `deployer@{{ .MeshIP }}`,
# not the public IP. No personal account, no home stack, no wheel: the
# one login is `deployer` (modules/ops/deployer.nix). Public surface is the {{ .Provider }} cloud firewall
# (default-deny + 80/443 + wireguard, forts/pulumi) in front of the host's
# own firewall. Break-glass is the console password (ops/console.nix)
# at Lish in the Linode console.
{ inputs, lib, ... }:

{
  imports = [
    # Linode runtime contract (upstream linode-config.nix, by-label devices)
    # — declares sfi.platform = "linode", which is how the flake knows to
    # build `{{ .Hostname }}-linode`.
    inputs.forts.nixosModules.runtime-linode
    # Role modules — the host dir is self-describing so the flake stays uniform
    # and needs no per-host edit when a new host gets a manifest.
    ./secrets.nix
    inputs.forts.nixosModules.k3s-server
    inputs.forts.nixosModules.wireguard    # mesh member (mesh_ip in the manifest)
    # The baseline every fort imports, which k3s-server names too: the
    # hardening (mesh-only SSH, no home stack, #86/#417) and the operator
    # account `deployer` with the ops verbs (#647). k3s-server adds the
    # cluster grant and the ports. The keys of `deployer` are the estate's,
    # not the framework's: estate.toml's operator_keys (sfi/forts#81).
    inputs.forts.nixosModules.hardened
    inputs.forts.nixosModules.ops-deployer
    # Day-0 flux: fort scaffold rendered
{{- if .Anonymous }}
    # flux/clusters/{{ .Hostname }}/ and the identity pre-seed put
    # flux-sops-age-key into this host's sops file. No deploy key: the
    # estate's repo is public, cloned anonymously over https (estate.toml
    # [source], forts#167).
{{- else }}
    # flux/clusters/{{ .Hostname }}/ and the identity pre-seed put
    # flux-sops-age-key + flux-git-deploy-key into this host's sops file.
{{- end }}
    inputs.forts.nixosModules.flux-bootstrap
    inputs.forts.nixosModules.auto-rebuild # pull-based OS updates (#93)
    # The operator defaults every fort carries (sfi/forts#24): the shell at
    # a pane, and the console door — a password for `deployer` that only a
    # getty accepts, so an operator reaches `sudo nixos-rollback` after
    # the mesh breaks (#524). fort mint minted the hash into this host's
    # sops file and the passphrase into provisioning/console-passwords.yaml.
    inputs.forts.nixosModules.shell
    inputs.forts.nixosModules.ops-console
{{ if .Links }}    inputs.forts.nixosModules.links       # on the mesh of another estate ([links.<name>] in the manifest)
{{ end }}  ];

  networking.hostName = "{{ .Hostname }}";

  # The estate this host is declared in: three levels up from this file.
  # The framework's modules (inputs.forts.nixosModules.*, above) read the
  # estate's files — mesh/peers.json, the flux tree, nixos/.sops.yaml, the
  # lab CA — under this root (modules/estate.nix in sfi/forts).
  sfi.estate.root = ../../..;

  # zsh and the shared prompt for whoever reads a pane here (#576). The
  # prompt's host label is the module's bright-black; a fort that wants
  # another sets sfi.shell.starshipSettings.hostname.style here (#582).
  sfi.shell.enable = true;

  # The console door (#524): the getty reads deployer-password-hash from
  # this host's sops file, and sshd still refuses the password. Read the
  # passphrase with `fort console-password {{ .Hostname }} --show`; replace
  # it with `--rotate`.
  sfi.ops.console.enable = true;

  # Upstream linode-config.nix sets PermitRootLogin = "prohibit-password"
  # at normal priority, colliding with common.nix's "no" — ours wins:
  # root never logs in, Lish is the break-glass.
  services.openssh.settings.PermitRootLogin = lib.mkForce "no";

  # Cloud host, no LAN. The names this fort needs are the hosts of its
  # mesh, <host>.{{ .Zone }} from mesh/peers.json, and the forge's pin
  # (its [hubs.forge] name, at the address estate.toml's [hubs.forge] host has
  # in that same file — forts#26): both in /etc/hosts and in
  # coredns-custom, rendered by modules/mesh-dns.nix and
  # modules/lab-dns.nix (forts#45). No split
  # DNS over the mesh: a
  # cloud fort knows no other .lofi name, and public names never ride the
  # tunnel (the wireguard module keeps {{ .MeshInterface }} off resolved's
  # default route).
  services.resolved.enable = true;

  sfi.flux-bootstrap = {
    enable = true;
    cluster = "{{ .Hostname }}";
  };

  # Watch main (minutely gate, rebuild only when the closure inputs
  # changed); a changed host config lands within minutes — or now, via
  # `sudo nixos-pull` (#93).
  sfi.auto-rebuild.enable = true;
  sfi.auto-rebuild.repoUrl = "{{ .RepoURL }}"; # the estate (estate.toml): what the gate watches and the rebuild clones
{{ if .AuditLogging }}
  # [cluster] audit_logging = true in this fort's manifest (#626). The
  # API server writes an audit log under /var/log/kube-audit (policy and
  # rotation in modules/k3s-audit.nix) and a monitoring layer's log
  # shipper ships it as job="kube-audit". The record a bounded admin window
  # needs (#618); costs disk, so a fort opts in by name.
  sfi.k3s.auditLog.enable = true;
{{ end }}
  # The k3s datastore, from [cluster] datastore in the manifest
  # (modules/k3s-server.nix maps it to services.k3s.clusterInit). 4 GB-SKU
  # parity with staging-k3s, both proven there 2026-09-11/12: sqlite
  # instead of embedded etcd (#164 — k3s-server with etcd was 1.3 GB of
  # the node; sqlite→etcd migrates in place later if an HA join ever
  # happens, the reverse does not)…
  sfi.k3s.datastore = "{{ .Datastore }}";

  # …and zram swap (#163): swapless 4 GB nodes hit page-cache thrash as
  # a cliff (memory PSI full-stalls while the kernel re-reads evicted
  # program text; kubelet never sees MemoryPressure). Compressed swap in
  # RAM makes it gradual and observable. Note upstream linode-config.nix
  # also mounts /dev/sdb as disk swap — zram's higher priority wins
  # while it has room, the disk tier catches overflow.
  zramSwap = {
    enable = true;
    memoryPercent = 50;
  };
  boot.kernel.sysctl = {
    # zram tunings: swap is now cheaper than a disk round-trip, so swap
    # aggressively instead of shredding page cache…
    "vm.swappiness" = 180;
    # …and don't readahead swap pages (no seek penalty on zram).
    "vm.page-cluster" = 0;
  };
{{ template "links.nix.gotpl" . }}
  # sops wiring is in ./secrets.nix: it points defaultSopsFile at
  # secrets/{{ .Hostname }}.yaml and decrypts via the pre-seeded SSH host
  # key (age.sshKeyPaths), which the initrd places from the Linode
  # Metadata channel before activation (modules/runtime/seed.nix, #606).
  # Secrets are split per-host, so this host only declares the keys it
  # actually carries — no declared-but-absent secrets to fail activation.

  system.stateVersion = "{{ .StateVersion }}";
}
