{{- if .Baremetal -}}
# {{ .Hostname }} — single-node k3s on lab hardware.
#
# GENERATED by `fort scaffold {{ .Hostname }}` from its manifest,
# forts/{{ .Hostname }}.toml. Scaffolding never overwrites this
# file — the manifest seeds the host, you refine it here.
#
# Built as a raw UEFI disk image via the upstream image framework (#287) —
# the flake auto-discovers this dir and exposes it as
# `{{ .Hostname }}-baremetal` (the runtime-baremetal import below says which
# variant). The root filesystem, ESP and bootloader come from
# runtime/baremetal.nix + the raw-efi image variant, and the initrd
# reaches any disk on any controller, so there is no hand-written
# hardware.nix: the image boots the machine, not a description of it.
# Written to the disk by hand from a live ISO (docs/baremetal.md).
{{- else -}}
# {{ .Hostname }} — single-node k3s VM.
#
# GENERATED by `fort scaffold {{ .Hostname }}` from its manifest,
# forts/{{ .Hostname }}.toml. Scaffolding never overwrites this
# file — the manifest seeds the host, you refine it here.
#
# Built as a qcow2 via the upstream image framework (#95) — the flake auto-
# discovers this dir and exposes it as `{{ .Hostname }}-qcow` (the
# runtime-qemu import below says which variant). The root filesystem and
# bootloader come from runtime/qemu.nix + the qemu image variant, so there
# is no hand-written hardware.nix.
{{- end }}
# HARDENED (every fort, modules/hardened.nix): SSH answers on the
# wireguard mesh address ONLY — reach it as `deployer@{{ .MeshIP }}`,
# not the LAN/public IP. No personal account, no home stack, no wheel: the
# one login is `deployer` (modules/ops/deployer.nix). Break-glass is the console password
# (ops/console.nix) at the machine's own console{{ if not .Baremetal }} — `virsh console
# {{ .Hostname }}` on the hypervisor{{ end }}.
{ inputs, ... }:

{
  imports = [
{{- if .Baremetal }}
    # Physical-host runtime contract (all-hardware initrd, root + ESP by
    # label, systemd-boot on the ESP's fallback path) — declares
    # sfi.platform = "baremetal", which is how the flake knows to build
    # `{{ .Hostname }}-baremetal`.
    inputs.forts.nixosModules.runtime-baremetal
{{- else }}
    # qcow VM runtime contract (virtio guest profile, root-by-label, grub on
    # /dev/vda, serial console) — declares sfi.platform = "qemu", which is
    # how the flake knows to build `{{ .Hostname }}-qcow`.
    inputs.forts.nixosModules.runtime-qemu
{{- end }}
    # Role modules — the host dir is self-describing so the flake stays uniform
    # and needs no per-host edit when a new host gets a manifest.
    ./secrets.nix
    inputs.forts.nixosModules.k3s-server
    inputs.forts.nixosModules.wireguard    # mesh member (mesh_ip in the manifest)
    # The baseline every fort imports, which k3s-server names too: the
    # hardening (mesh-only SSH, no home stack, #86/#417) and the operator
    # account `deployer` with the ops verbs (#647). k3s-server adds the
    # cluster grant and the ports. The keys of `deployer` are the estate's,
    # not the framework's: estate.toml's operator_keys (sfi/forts#81).
    inputs.forts.nixosModules.hardened
    inputs.forts.nixosModules.ops-deployer
    # Day-0 flux: fort scaffold laid down
{{- if .Anonymous }}
    # flux/clusters/{{ .Hostname }}/ and fort mint seeded flux-sops-age-key
    # into this host's sops file. No deploy key: the estate's repo is
    # public, cloned anonymously over https (estate.toml [source], forts#167).
{{- else }}
    # flux/clusters/{{ .Hostname }}/ and fort mint seeded flux-sops-age-key +
    # flux-git-deploy-key into this host's sops file.
{{- end }}
    inputs.forts.nixosModules.flux-bootstrap
    inputs.forts.nixosModules.auto-rebuild # pull-based OS updates (#93)
    # The operator defaults every fort carries (sfi/forts#24): the shell at
    # a pane, and the console door — a password for `deployer` that only a
    # getty accepts, so an operator reaches `sudo nixos-rollback` after
    # the mesh breaks (#524). fort mint minted the hash into this host's
    # sops file and the passphrase into provisioning/console-passwords.yaml.
    inputs.forts.nixosModules.shell
    inputs.forts.nixosModules.ops-console
{{ if .Links }}    inputs.forts.nixosModules.links       # on the mesh of another estate ([links.<name>] in the manifest)
{{ end }}  ];

  networking.hostName = "{{ .Hostname }}";

  # The estate this host is declared in: three levels up from this file.
  # The framework's modules (inputs.forts.nixosModules.*, above) read the
  # estate's files — mesh/peers.json, the flux tree, nixos/.sops.yaml, the
  # lab CA — under this root (modules/estate.nix in sfi/forts).
  sfi.estate.root = ../../..;

  # zsh and the shared prompt for whoever reads a pane here (#576). The
  # prompt's host label is the module's bright-black; a fort that wants
  # another sets sfi.shell.starshipSettings.hostname.style here (#582).
  sfi.shell.enable = true;

  # The console door (#524): the getty reads deployer-password-hash from
  # this host's sops file, and sshd still refuses the password. Read the
  # passphrase with `fort console-password {{ .Hostname }} --show`; replace
  # it with `--rotate --write`.
  sfi.ops.console.enable = true;

  sfi.flux-bootstrap = {
    enable = true;
    cluster = "{{ .Hostname }}";
  };

  # Watch main (minutely gate, rebuild only when the closure inputs
  # changed); a changed host config lands within minutes — or now, via
  # `sudo nixos-pull` (#93).
  sfi.auto-rebuild.enable = true;
  sfi.auto-rebuild.repoUrl = "{{ .RepoURL }}"; # the estate (estate.toml): what the gate watches and the rebuild clones
{{ if .AuditLogging }}
  # [cluster] audit_logging = true in this fort's manifest (#626). The
  # API server writes an audit log under /var/log/kube-audit (policy and
  # rotation in modules/k3s-audit.nix) and a monitoring layer's log
  # shipper ships it as job="kube-audit". The record a bounded admin window
  # needs (#618); costs disk, so a fort opts in by name.
  sfi.k3s.auditLog.enable = true;
{{ end }}
{{- if .Baremetal }}
  # Static address on the lab LAN — matches [baremetal] ip in
  # forts/{{ .Hostname }}.toml.
{{- if .MAC }}
  # Matched by MAC ([baremetal] mac), not by name: a NIC behind a dock or
  # a USB port is named for where it is plugged in (enp116s0f4u1u1 and
  # its next spelling), and `en*` would also claim any second adapter.
{{- end }}
{{- else }}
  # Static address on the hypervisor's LAN bridge — matches [libvirt] ip in
  # forts/{{ .Hostname }}.toml.
{{- end }}
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-lan" = {
{{- if .MAC }}
    matchConfig.MACAddress = "{{ .MAC }}";
{{- else }}
    matchConfig.Name = "en*";
{{- end }}
    address = [ "{{ .IP }}/{{ .LanPrefix }}" ];
    gateway = [ "{{ .LanGateway }}" ];
    dns = [ {{ range $i, $d := .LanDNS }}{{ if $i }} {{ end }}"{{ $d }}"{{ end }} ];
  };

{{- if eq .Datastore "etcd" }}
  # Single-node server with embedded etcd ([cluster] datastore = "etcd"
  # in the manifest): cluster-init, the opt-in for an HA join. Server
  # config and the k3s-token requirement come from modules/k3s-server.nix,
  # which maps the datastore to services.k3s.clusterInit.
  sfi.k3s.datastore = "etcd";
{{- else }}
  # Single-node server on the sqlite datastore ([cluster] datastore in
  # the manifest): a single node buys nothing from etcd, and k3s-server
  # with etcd was a third of a 4 GB node (#163/#164). Server config and
  # the k3s-token requirement come from modules/k3s-server.nix, which
  # maps the datastore to services.k3s.clusterInit.
  sfi.k3s.datastore = "sqlite";
{{- end }}

  # zram swap (#163): swapless 4 GB nodes hit page-cache thrash as a
  # cliff (memory PSI full-stalls while the kernel re-reads evicted
  # program text; kubelet never sees MemoryPressure). Compressed swap in
  # RAM makes it gradual and observable. The lab shape has no disk swap
  # tier: zram is all there is.
  zramSwap = {
    enable = true;
    memoryPercent = 50;
  };
  boot.kernel.sysctl = {
    # swap is now cheaper than a disk round-trip, so swap aggressively
    # instead of shredding page cache…
    "vm.swappiness" = 180;
    # …and don't readahead swap pages (no seek penalty on zram).
    "vm.page-cluster" = 0;
  };
{{ template "links.nix.gotpl" . }}
  # sops wiring is in ./secrets.nix: it points defaultSopsFile at
  # secrets/{{ .Hostname }}.yaml and decrypts via the pre-seeded SSH host key
  # (age.sshKeyPaths){{ if eq .Provider "libvirt" }}, which the initrd places from the NoCloud cidata
  # volume before activation (modules/runtime/seed.nix, #657){{ else if .Cloud }}, which the initrd places from the Linode
  # Metadata channel before activation (modules/runtime/seed.nix, #606){{ else }}, which the baremetal
  # channel (#658) will place before activation — the image carries no key{{ end }}. Secrets are
  # split per-host, so this host only declares the keys it actually carries —
  # no declared-but-absent secrets to fail activation.

  system.stateVersion = "{{ .StateVersion }}";
}
