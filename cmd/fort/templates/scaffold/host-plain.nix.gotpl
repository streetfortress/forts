# {{ .Hostname }} — plain fort: the baseline host, no cluster.
#
# GENERATED by `fort scaffold {{ .Hostname }}` from its manifest,
# forts/{{ .Hostname }}.toml. Scaffolding never overwrites this
# file — the manifest seeds the host, you refine it here.
#
{{- if .Cloud }}
# Built as a Linode image via the upstream framework (#95/#42) — the flake
# exposes it as `{{ .Hostname }}-linode` (the runtime-linode import below
# says which variant). Root filesystem, bootloader (GRUB + LISH serial),
# eth0 DHCP, and swap on /dev/sdb all come from upstream's linode-config.nix
# via modules/runtime/linode.nix — no hand-written hardware.nix and no
# static-LAN block.
{{- else if .Baremetal }}
# Built as a raw UEFI disk image via the upstream image framework (#287) —
# the flake auto-discovers this dir and exposes it as
# `{{ .Hostname }}-baremetal` (the runtime-baremetal import below says which
# variant). The root filesystem, ESP and bootloader come from
# runtime/baremetal.nix + the raw-efi image variant, and the initrd
# reaches any disk on any controller, so there is no hand-written
# hardware.nix: the image boots the machine, not a description of it.
# Written to the disk by hand from a live ISO (docs/baremetal.md).
{{- else }}
# Built as a qcow2 via the upstream image framework (#95) — the flake auto-
# discovers this dir and exposes it as `{{ .Hostname }}-qcow` (the
# runtime-qemu import below says which variant). The root filesystem and
# bootloader come from runtime/qemu.nix + the qemu image variant, so there
# is no hand-written hardware.nix.
{{- end }}
# PLAIN FORT (no [cluster] table in the manifest): no k3s, no flux.
# What the framework gives every fort and nothing more — the
# hardened host, the mesh, the operator account `deployer` with the ops
# verbs (modules/ops/deployer.nix, #647), the shell at a pane, the rebuild
# loop. Ideally nobody logs in; the prescribed access is
# `deployer@{{ .MeshIP }}` over the mesh for the ops verbs, and the console
{{- if .Cloud }}
# password (ops/console.nix) at Lish in the Linode console as the
# break-glass. What this host does beyond
{{- else if .Baremetal }}
# password (ops/console.nix) at the machine's own console as the
# break-glass. What this host does beyond
{{- else }}
# password (ops/console.nix) as the break-glass. What this host does beyond
{{- end }}
# that — accounts, services, a role — is plain NixOS, written below by the
# estate.
{ inputs, {{ if .Cloud }}lib, {{ end }}... }:

{
  imports = [
{{- if .Cloud }}
    # Linode runtime contract (upstream linode-config.nix, by-label devices)
    # — declares sfi.platform = "linode", which is how the flake knows to
    # build `{{ .Hostname }}-linode`.
    inputs.forts.nixosModules.runtime-linode
{{- else if .Baremetal }}
    # Physical-host runtime contract (all-hardware initrd, root + ESP by
    # label, systemd-boot on the ESP's fallback path) — declares
    # sfi.platform = "baremetal", which is how the flake knows to build
    # `{{ .Hostname }}-baremetal`.
    inputs.forts.nixosModules.runtime-baremetal
{{- else }}
    # qcow VM runtime contract (virtio guest profile, root-by-label, grub on
    # /dev/vda, serial console) — declares sfi.platform = "qemu", which is
    # how the flake knows to build `{{ .Hostname }}-qcow`.
    inputs.forts.nixosModules.runtime-qemu
{{- end }}
    # Role modules — the host dir is self-describing so the flake stays uniform
    # and needs no per-host edit when a new host gets a manifest.
    ./secrets.nix
    # A plain fort has no role module, so this list IS its role
    # (sfi/forts#60): the estate, the mesh and the names on it, the
    # metrics the hub scrapes, and today's homelab DNS. Each one is named
    # here — a role depends on no bundle.
    inputs.forts.nixosModules.estate       # sfi.estate.root (below) and the estate's CA root
    inputs.forts.nixosModules.wireguard    # mesh member (mesh_ip in the manifest), and the names of the mesh
    inputs.forts.nixosModules.metrics      # node-exporter on 9100 and the textfile collectors
    inputs.forts.nixosModules.lab-dns      # the forge's name pin ([hubs.forge] + mesh/peers.json), and the LAN zone's forward on a lab fort
    # The baseline, which the cluster profile also builds on: the
    # hardening every fort shares, the operator account and its verbs.
    # The keys of `deployer` are the estate's, not the framework's:
    # estate.toml's operator_keys (sfi/forts#81). This host carries that
    # list unless it sets sfi.ops.deployer.authorizedKeys itself.
    inputs.forts.nixosModules.hardened
    inputs.forts.nixosModules.ops-deployer
    inputs.forts.nixosModules.shell        # the prompt, keys and aliases at a pane (#557)
    # The console door (sfi/forts#24, #524): a password for `deployer` that
    # only a getty accepts. fort mint minted the hash into this host's sops
    # file and the passphrase into provisioning/console-passwords.yaml.
    inputs.forts.nixosModules.ops-console
    inputs.forts.nixosModules.auto-rebuild # pull-based OS updates (#93)
{{- if .Links }}
    inputs.forts.nixosModules.links       # on the mesh of another estate ([links.<name>] in the manifest)
{{- end }}
  ];

  networking.hostName = "{{ .Hostname }}";

  # The estate this host is declared in: three levels up from this file.
  # The framework's modules (inputs.forts.nixosModules.*, above) read the
  # estate's files — mesh/peers.json, the flux tree, nixos/.sops.yaml, the
  # lab CA — under this root (modules/estate.nix in sfi/forts).
  sfi.estate.root = ../../..;

  # zsh and the shared prompt for whoever reads a pane here (#576).
  sfi.shell.enable = true;

  # The console door (#524): the getty reads deployer-password-hash from
  # this host's sops file, and sshd still refuses the password. Read the
  # passphrase with `fort console-password {{ .Hostname }} --show`; replace
  # it with `--rotate`.
  sfi.ops.console.enable = true;

  # BREAK-GLASS, off (sfi/forts#195): flip to true to give deployer
  # `sudo -i` — and cluster-admin kubectl on a cluster fort — behind the
  # admin-key challenge (modules/ops/admin.nix; docs/ops.md "Escalating
  # to Admin"). The challenge options live at sfi.ops.admin.challenge.*;
  # its enable defaults to true, and false is passwordless sudo.
  sfi.ops.admin.enable = false;
{{ if .Cloud }}
  # Upstream linode-config.nix sets PermitRootLogin = "prohibit-password"
  # at normal priority, colliding with common.nix's "no" — ours wins:
  # root never logs in, Lish is the break-glass.
  services.openssh.settings.PermitRootLogin = lib.mkForce "no";

  # Cloud host, no LAN. The names this fort needs are the hosts of its
  # mesh, <host>.{{ .Zone }} from mesh/peers.json, and the forge's pin
  # (its [hubs.forge] name, at the address estate.toml's [hubs.forge] host
  # has in that same file — forts#26): both in /etc/hosts, rendered by
  # modules/mesh-dns.nix and modules/lab-dns.nix (forts#45). A cloud fort
  # knows no other .lofi name, and public names never ride the tunnel
  # (the wireguard module keeps {{ .MeshInterface }} off resolved's
  # default route).
  services.resolved.enable = true;
{{ end }}
  # Watch main; a changed host config lands within a minute or two of
  # merging — or now, via `sudo nixos-pull` as deployer (#93).
  # deployer holds the host's verbs (nixos-pull, nixos-rollback,
  # nixos-revision; `ops` lists them); the loop is the only other way
  # config reaches this host.
  sfi.auto-rebuild.enable = true;
  sfi.auto-rebuild.repoUrl = "{{ .RepoURL }}"; # the estate (estate.toml): what the gate watches and the rebuild clones
{{ if not .Cloud }}
{{- if .Baremetal }}
  # Static address on the lab LAN — matches [baremetal] ip in
  # forts/{{ .Hostname }}.toml.
{{- if .MAC }}
  # Matched by MAC ([baremetal] mac), not by name: a NIC behind a dock or
  # a USB port is named for where it is plugged in (enp116s0f4u1u1 and
  # its next spelling), and `en*` would also claim any second adapter.
{{- end }}
{{- else }}
  # Static address on the hypervisor's LAN bridge — matches [libvirt] ip in
  # forts/{{ .Hostname }}.toml.
{{- end }}
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-lan" = {
{{- if .MAC }}
    matchConfig.MACAddress = "{{ .MAC }}";
{{- else }}
    matchConfig.Name = "en*";
{{- end }}
    address = [ "{{ .IP }}/{{ .LanPrefix }}" ];
    gateway = [ "{{ .LanGateway }}" ];
    dns = [ {{ range $i, $d := .LanDNS }}{{ if $i }} {{ end }}"{{ $d }}"{{ end }} ];
  };
{{ end }}
{{- if .Cloud }}
  # zram swap (#163): a 4 GB SKU under memory pressure should degrade
  # gradually, not fall off a page-cache cliff. Note upstream
  # linode-config.nix also mounts /dev/sdb as disk swap — zram's higher
  # priority wins while it has room, the disk tier catches overflow.
{{- else }}
  # zram swap (#163): a build box under memory pressure should degrade
  # gradually, not fall off a page-cache cliff. The lab shape has no disk
  # swap tier: zram is all there is.
{{- end }}
  zramSwap = {
    enable = true;
    memoryPercent = 50;
  };
  boot.kernel.sysctl = {
    # swap is now cheaper than a disk round-trip, so swap aggressively
    # instead of shredding page cache…
    "vm.swappiness" = 180;
    # …and don't readahead swap pages (no seek penalty on zram).
    "vm.page-cluster" = 0;
  };
{{ template "links.nix.gotpl" . }}
  # sops wiring is in ./secrets.nix: it points defaultSopsFile at
  # secrets/{{ .Hostname }}.yaml and decrypts via the pre-seeded SSH host key
{{- if .Cloud }}
  # (age.sshKeyPaths), which the initrd places from the Linode Metadata
  # channel before activation (modules/runtime/seed.nix, #606). Secrets are
{{- else if .Baremetal }}
  # (age.sshKeyPaths), which the baremetal channel (#658) will place before
  # activation — the image carries no key. Secrets are
{{- else }}
  # (age.sshKeyPaths), which the initrd places from the NoCloud cidata
  # volume before activation (modules/runtime/seed.nix, #657). Secrets are
{{- end }}
  # split per-host, so this host only declares the keys it actually carries —
  # no declared-but-absent secrets to fail activation.

  system.stateVersion = "{{ .StateVersion }}";
}
