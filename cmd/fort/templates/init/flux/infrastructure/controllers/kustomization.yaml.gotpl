apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - prometheus-operator-crds
  - gateway-api
  - traefik
  - cert-manager
  - cnpg
  - kube-state-metrics
  - prometheus-operator
{{- if .Push }}
  # The log shipper exists to push to the hub's Loki over the mesh; an
  # estate with no hub has none.
  - fluent-bit
{{- end }}
