{{- if .ACMEEmail }}
# Public ACME issuer for the estate's public hostnames (#43). Shared
# layer: a cluster with no public name never references it. The http01
# gateway solver: challenge routes attach to the per-cluster Gateway's
# http listener, which a cloud fort's firewall admits on 80.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: letsencrypt
spec:
  acme:
    # The directory: estate.toml [acme] directory at init; absent, Let's
    # Encrypt. A private directory (a step-ca) needs the estate's CA file
    # trusted in-cluster — a layer's concern, not this file's.
    server: {{ .ACMEDirectory }}
    # ACME account contact (expiry/deprecation notices): estate.toml
    # [acme] email at init. Mutable metadata: an edit here changes it.
    email: {{ .ACMEEmail }}
    privateKeySecretRef:
      name: letsencrypt-acme-account-key
    solvers:
      - http01:
          gatewayHTTPRoute:
            parentRefs:
              - name: homelab
                namespace: traefik
{{- end }}
