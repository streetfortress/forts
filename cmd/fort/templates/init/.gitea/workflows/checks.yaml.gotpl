# The estate's gate, on every push: `fort check --all` (tree ↔ manifests,
# kustomize builds, strict envsubst, contracts ↔ Secrets), the CRD diff
# of every chart version the push moves (`fort crd-diff`), and a full
# module-system eval of every host that has a manifest. All three come
# from the framework this estate pins: `nix run ./nixos#fort` is the CLI
# at that pin.
#
# Two red-X states are DELIBERATE gates, not breakage: a staged-but-
# unseeded app tree (listed-but-absent sops files fail kustomize) and a
# staged-but-unprovisioned host (a missing mesh peer fails nix eval).
# Such PRs go green when the provisioning replay seeds identity + secrets.
name: checks

on:
  push:

jobs:
  gate:
    runs-on: ubuntu-latest
    # The closure of the framework pin comes from the runner's own cache
    # server, not from cache.nixos.org on every push (forts#75). act_runner
    # starts a fresh job container per run, so nothing in /nix survives a
    # run. What survives is one actions/cache entry that holds a Nix
    # *binary cache* directory — narinfo and nar files, which are ordinary
    # files a tar can carry. The store itself is never in the tar: nix
    # reads the restored directory as a substituter and imports only the
    # paths this run asks for, so no restore has to reproduce
    # /nix/store's ownership or its read-only paths.
    env:
      # priority 10 wins against cache.nixos.org's 40, so a path the cache
      # holds never goes over the WAN. trusted=true accepts the unsigned
      # narinfo that `nix copy` writes when no signing key exists; the
      # entry is private to this repository, and only its own runs write it.
      NIX_CONFIG: |
        extra-substituters = file:///nix-closure-cache?trusted=true&priority=10
    steps:
      - uses: actions/checkout@v6

      - name: The base branch is in this checkout
        # `fort crd-diff` reads the chart version main states and
        # compares it with the one this tree states. actions/checkout
        # clones at depth 1, so the checkout holds no main at all and
        # `git show origin/main:<path>` has nothing to read. One commit
        # is all the verb wants: it never walks the history between the
        # two.
        run: git fetch --no-tags --depth=1 origin main

      - uses: DeterminateSystems/nix-installer-action@v16

      - uses: azure/setup-helm@v4
        with:
          version: v4.1.3

      - name: Restore the closure of the framework pin
        id: closure
        uses: actions/cache@v4
        with:
          path: /nix-closure-cache
          key: nix-closure-v2-${{ "{{" }} hashFiles('nixos/flake.lock') {{ "}}" }}
          # A moved pin restores the previous cache and fetches the delta.
          restore-keys: nix-closure-v2-

      - name: The cache directory exists before nix reads it
        # nix refuses a file:// substituter whose directory is absent, and
        # a full miss restores nothing.
        run: mkdir -p /nix-closure-cache

      - name: The gate (fort check --all)
        env:
          GITEA_ACTIONS: "true"
        run: |
          set -euo pipefail
          if [ -f flux/infrastructure/configs/step-ca-root.pem ]; then
            helm registry login {{ .Registry }} --ca-file flux/infrastructure/configs/step-ca-root.pem \
              --username "${{ "{{" }} gitea.actor {{ "}}" }}" --password-stdin <<< "${{ "{{" }} secrets.REGISTRY_TOKEN {{ "}}" }}"
          fi
          nix run ./nixos#fort -- check --all

      - name: The CRD diff of every chart version that moved (fort crd-diff)
        # A chart that ships its CRDs in its own crds/ directory leaves
        # them outside the release: helm never touches them after the
        # install, and the helm-controller defaults spec.upgrade.crds to
        # Skip, which neither replaces an existing CRD nor creates a new
        # one. So a chart bump can move the schema that validates every
        # custom object of a kind on every fort, and the only record of
        # it is one line in the upstream release notes that Renovate
        # pastes into the PR body. This step reads the chart instead.
        #
        # A step of the gate, not a job of its own: the verb comes from
        # the framework pin, so a separate job would install nix and
        # restore the closure a second time on every push. The log of
        # this job carries the diff, and the finding is an annotation.
        env:
          GITEA_ACTIONS: "true"
        run: nix run ./nixos#fort -- crd-diff

      - name: Eval every host with a manifest
        run: |
          set -euo pipefail
          # nullglob: with no manifest the bare glob would stay literal and
          # basename would print "*", which re-globs to every top-level entry.
          shopt -s nullglob
          manifests=(forts/*.toml)
          if [ "${#manifests[@]}" -eq 0 ]; then
            echo "no fort has a manifest; nothing to eval"
            exit 0
          fi
          fail=0
          for f in "${manifests[@]}"; do
            host=$(basename -s .toml "$f")
            echo "== nix eval $host"
            if ! nix eval --raw "./nixos#nixosConfigurations.${host}.config.system.build.toplevel.drvPath"; then
              echo "::error::nix eval failed for ${host}"
              fail=1
            fi
            echo
          done
          exit "$fail"

      - name: Refill the cache with what this run used
        # An exact hit refills nothing: the bulk is nixpkgs, and nixpkgs
        # moves only when nixos/flake.lock moves. A moved lock, or no
        # cache, writes the directory again from the store, so the cache
        # holds this closure and no path of an older one.
        if: steps.closure.outputs.cache-hit != 'true'
        run: |
          set -euo pipefail
          rm -rf /nix-closure-cache
          mkdir -p /nix-closure-cache
          # Every eval writes .drv files, and nix substitutes none of them:
          # they were 4526 of the 5428 paths in the first entry, for 9MB of
          # its 625MB. The gain is the file count, not the bytes — the copy,
          # the tar and the restore each handle 902 paths instead of 5428.
          nix path-info --all | grep -v '\.drv$' \
            | xargs nix copy --to "file:///nix-closure-cache?compression=zstd"
          du -sh /nix-closure-cache
