# {{ .Name }} — an estate: the forts declared here, built on sfi/forts.
# Rendered by `fort init`; every verb reads it (docs/init.md in sfi/forts).
name = "{{ .Name }}"
repo = "{{ .Repo }}"
{{- if .Mesh }}
mesh = "{{ .Mesh }}"          # the WireGuard subnet; every mesh_ip and every peers.json address lies in it
{{- else }}
# mesh = "10.2.0.0/24"       # the WireGuard subnet of this estate; fort check keeps every
                             # mesh_ip and every peers.json address inside it. Two estates
                             # link only when their meshes do not overlap (deployments#674).
{{- end }}
{{- if .Interface }}
interface = "{{ .Interface }}"   # the WireGuard interface every host gives this mesh (≤ 15 characters)
{{- else }}
# interface = "wg-second"    # the WireGuard interface every host on this mesh gives it: a fort's
                             # own, and a linked host's link interface. ≤ 15 characters. Absent: wg0.
{{- end }}
{{- if .Zone }}
zone = "{{ .Zone }}"          # the DNS zone of the mesh: every host on it is <host>.{{ .Zone }}
{{- else }}
# zone = "{{ .Name }}.mesh"    # the DNS zone of the mesh (docs/mesh.md): every peer and remote
                             # of peers.json is <host>.<zone> at its mesh address, on every fort
                             # and in its cluster DNS. Absent: <name>.mesh, i.e. {{ .Name }}.mesh.
{{- end }}

# The hubs (docs/hub.md): the roles another fort serves this estate — the
# forge every fort clones from, the monitoring hub the edges push to and
# that notices a silent fort, the CA a lab issuer reaches. Each names the
# estate that holds the hub by its git URL (this estate's own `repo` for
# an in-estate hub) and the fort that is it. The hub's address on this
# mesh is that fort's entry in mesh/peers.json: its manifest when the
# estate is this one, its `remotes` entry when it is another's (the link,
# docs/links.md).
{{- range .Hubs }}

[hubs.{{ .Role }}]
estate = "{{ .Estate }}"
fort = "{{ .Fort }}"
{{- if .Name }}
name = "{{ .Name }}"           # the forge's one name on every mesh
{{- end }}
{{- end }}
{{- if not .Push }}

# [hubs.monitoring]            # no monitoring hub: edge-only, and nobody notices a
# estate = "ssh://git@gitea.zen.lofi:30022/sfi/infra"   # silent fort. Adding one later means
# fort = "luxor"               # re-rendering flux/infrastructure and HUB_MESH_IP in
                               # every cluster-vars by hand (docs/init.md).
{{- end }}
{{- if not .Forge }}

# [hubs.forge]                 # the forge: the gitea every fort clones from, by its one
# estate = "ssh://git@gitea.zen.lofi:30022/sfi/infra"   # name on every mesh. lab-dns.nix pins
# fort = "sfi-fort-zenbook"    # that name to the address `fort` has in mesh/peers.json
# name = "gitea.zen.lofi"      # (forts#26). No forge host, no pin.
{{- end }}

# The other half, declared by the hub's estate, by role: a fort of this
# estate and the estates it serves that role. fort scaffold <fort>
# renders the flux subscription for each estate a monitoring entry names
# it the hub of; the served estate renders what it asks into
# flux/hub/<fort>/ of its own tree. Two entries under one role are two
# hubs; an estate appears once per role.
# [[serves.forge]]
# fort = "sfi-fort-zenbook"
# estates = ["ssh://git@gitea.zen.lofi:30022/sfi/staging"]
# [[serves.monitoring]]
# fort = "luxor"
# estates = ["ssh://git@gitea.zen.lofi:30022/sfi/staging"]
