# {{ .Name }} — an estate: the forts declared here, built on sfi/forts.
# Rendered by `fort init`; every verb reads it (docs/init.md in sfi/forts).
name = "{{ .Name }}"
repo = "{{ .Repo }}"
{{- if .Mesh }}
mesh = "{{ .Mesh }}"          # the WireGuard subnet; every mesh_ip and every peers.json address lies in it
{{- else }}
# mesh = "10.2.0.0/24"       # the WireGuard subnet of this estate; fort check keeps every
                             # mesh_ip and every peers.json address inside it. Two estates
                             # link only when their meshes do not overlap (deployments#674).
{{- end }}
{{- if .Interface }}
interface = "{{ .Interface }}"   # the WireGuard interface every host gives this mesh (≤ 15 characters)
{{- else }}
# interface = "wg-second"    # the WireGuard interface every host on this mesh gives it: a fort's
                             # own, and a linked host's link interface. ≤ 15 characters. Absent: wg0.
{{- end }}
{{- if .Hub }}
hub = "{{ .Hub }}"
{{- else if .HubPush }}
hub_push = "{{ .HubPush }}"   # a hub in another estate: the edges push to it
{{- else }}
# hub = "<host>"             # the fort of this estate whose monitoring tree carries
                             # every other fort's file (its dead man's switch, its
                             # scrape) and whose rustfs the backups register with
# hub_push = "<mesh ip>"     # or a hub in another estate: the edges push to it
                             # Neither: edge-only, and nobody notices a silent fort.
                             # Changing this later means re-rendering flux/infrastructure
                             # and HUB_MESH_IP in every cluster-vars by hand.
{{- end }}
