# {{ .Name }} — an estate: the forts declared here, built on sfi/forts.
# Rendered by `fort init`; every verb reads it (docs/init.md in sfi/forts).
# TOML reads a loose key after a [table] header as that table's, so the
# loose keys (name, operator_keys) stay above the first table.
name = "{{ .Name }}"

# The operators (docs/init.md): the devices that hold `deployer`, the
# operator account of every fort of this estate (ops/deployer.nix). The
# framework ships no key, so this list is the one place an operator key
# enters: a fort accepts these keys and no others, and a fort you hand
# to another team is that team's estate with that team's keys. One line
# per device, in authorized_keys form, with the device as the comment —
# vetting trims the list by device. A fort of an estate that names none
# does not evaluate.
{{- if .OperatorKeys }}
operator_keys = [
{{- range .OperatorKeys }}
  "{{ . }}",
{{- end }}
]
{{- else }}
# operator_keys = [
#   "ssh-ed25519 AAAAC3Nza… macbook-air",
# ]
{{- end }}

# The source (docs/init.md): where this estate's tree comes from and how
# a fort reaches it. The clone route is SSH: flux and the rebuild loop
# clone `repo` with the deploy key `fort mint` registers, and both pin
# the forge's host key. `forge` and `auth` derive from `repo` when
# absent (gitea; ssh).
[source]
repo = "{{ .Repo }}"
{{- if .KnownHosts }}
known_hosts = "{{ .KnownHosts }}"   # the forge's SSH host key: every clone a fort makes pins it
{{- else }}
# known_hosts = "[forge.example]:22 ssh-ed25519 AAAA…"   # the forge's SSH host key, one known_hosts line
                             # (ssh-keyscan -p <port> <forge>): flux's clone and the rebuild loop pin
                             # it, and no fort evaluates until the estate names it.
{{- end }}
{{- if or .Mesh .Interface .Zone }}

[mesh]
{{- if .Mesh }}
cidr = "{{ .Mesh }}"          # the WireGuard subnet; every mesh_ip and every peers.json address lies
                             # in it, and its prefix is what the interfaces render. Two estates link
                             # only when their meshes do not overlap (deployments#674).
{{- end }}
{{- if .Interface }}
interface = "{{ .Interface }}"   # the WireGuard interface every host gives this mesh (≤ 15 characters)
{{- end }}
{{- if .Zone }}
zone = "{{ .Zone }}"          # the DNS zone of the mesh: every host on it is <host>.{{ .Zone }}
{{- end }}
{{- else }}

# [mesh]                      # the estate's WireGuard mesh (docs/mesh.md)
# cidr = "10.2.0.0/24"        # the subnet; fort check keeps every mesh_ip and every peers.json
                             # address inside it, and its prefix is what the interfaces render.
# interface = "wg-second"     # the interface every host on this mesh gives it: a fort's own, and a
                             # linked host's link interface. ≤ 15 characters. Absent: wg0.
# zone = "{{ .Name }}.mesh"    # the zone (docs/mesh.md): every peer and remote of peers.json is
                             # <host>.<zone> at its mesh address. Absent: <name>.mesh.
{{- end }}
{{- if .ACMEEmail }}

[acme]
email = "{{ .ACMEEmail }}"    # the public ACME account's contact: the shared layer carries an issuer
# directory = "{{ .ACMEDirectory }}"
                             # the ACME directory the issuer speaks to; absent, Let's Encrypt. A
                             # private directory (a step-ca) goes with the estate's CA file
                             # (nixos/certs/ca-root.pem), which every host of the estate trusts.
{{- else }}

# [acme]                      # set, and the shared layer carries an ACME ClusterIssuer for the
# email = "ops@example"       # estate's public names; absent, no public issuer.
# directory = "{{ .ACMEDirectory }}"
                             # the ACME directory the issuer speaks to; absent, Let's Encrypt.
{{- end }}

# The hubs (docs/hub.md): the roles another fort serves this estate. The
# forge every fort clones from is the one role the framework renders for
# (its name is pinned to the fort's address on this mesh). Every other
# role is a name you choose — a layer's (a monitoring hub) or your own —
# and the framework renders nothing for it: the hub is <fort>.<zone>, and
# the link opens the ports the hub's estate declares. Each names the
# estate that holds the hub by its git URL (this estate's own `repo` for
# an in-estate hub) and the fort that is it. The hub's address on this
# mesh is that fort's entry in mesh/peers.json: its manifest when the
# estate is this one, its `remotes` entry when it is another's (the link,
# docs/links.md).
{{- range .Hubs }}

[hubs.{{ .Role }}]
estate = "{{ .Estate }}"
fort = "{{ .Fort }}"
{{- if .Name }}
name = "{{ .Name }}"           # the forge's one name on every mesh
{{- end }}
{{- end }}
{{- if not .Forge }}

# [hubs.forge]                 # the forge: the gitea every fort clones from, by its one
# estate = "ssh://git@forge.example:22/acme/hub"   # name on every mesh. lab-dns.nix pins
# fort = "forge"               # that name to the address `fort` has in mesh/peers.json
# name = "forge.example"       # (forts#26). No forge host, no pin.
{{- end }}

# The other half, declared by the hub's estate, by role: a fort of this
# estate, the estates it serves that role, and — for every role but the
# forge — the ports the link opens for it (forts#105). Two entries under
# one role are two hubs; an estate appears once per role. A role with a
# render on the served side is a layer's (docs/layers.md): the layer's
# files say what the hub runs and what each served fort renders.
# [[serves.forge]]
# fort = "forge"
# estates = ["ssh://git@forge.example:22/acme/staging"]
# [[serves.monitoring]]
# fort = "central"
# estates = ["ssh://git@forge.example:22/acme/staging"]
# ports = [30990, 31100]
