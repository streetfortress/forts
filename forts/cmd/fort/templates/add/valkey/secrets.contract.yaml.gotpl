# Provider contract (docs/forts/fort-configuration-contracts.md) — NON-SECRET, rendered from the
# fort CLI's valkey template (there is no chart of ours to carry it);
# `fort seed` executes it.
# Key name = ACL username (the chart's usersExistingSecret convention).
# Each tenant registration appends its key here; {{ .SecretName }}'s
# {{ .Valkey.Key }} is sourced from this file — lockstep pair on rotation.
secrets:
  secrets.sops.yaml:
    metadata:
      name: valkey-users
      namespace: valkey
    keys:
      default: {generate: hex24}
      {{ .App }}: {generate: hex24}
