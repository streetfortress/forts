{{- if .PR -}}
# {{ .App }}'s chart as a single-chart OCI artifact (OCIRepository +
# HelmRelease.chartRef). PREVIEW PIN: this fort follows an unmerged PR —
# {{ .ChartRepo }}#{{ .PR }} — via the immutable per-commit prereleases its
# chart-preview workflow publishes (0.0.0-pr.{{ .PR }}.<run>.g<sha>, appVersion
# = <sha> so it pulls that commit's images). The semver filter follows
# the PR head without a commit here per iteration; the OCIRepository
# status records the exact revision running (at add time: {{ .Version }}).
# Renovate never sees a 0.0.0- prerelease. Once the PR merges and is
# tagged, this becomes a plain `tag:` pin.
{{- else -}}
# {{ .App }}'s chart as a single-chart OCI artifact (OCIRepository +
# HelmRelease.chartRef, ref.tag pinned = chart version). Published by the
# app repo's release workflow on `just tag X.Y.Z`; Renovate's flux
# manager tracks ref.tag for bump PRs.
{{- end }}
#
# certSecretRef: source-controller pods do NOT inherit the node's step-ca
# trust (unlike containerd image pulls), so the registry's CA is provided
# explicitly, generated from the local step-ca-root.pem copy by this
# app's kustomization.yaml.
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: {{ .App }}
  namespace: flux-system
spec:
{{- if .PR }}
  interval: 10m
{{- else }}
  interval: 1h
{{- end }}
  url: {{ .ChartURL }}
  ref:
{{- if .PR }}
    semver: ">=0.0.0-0"
    semverFilter: '^0\.0\.0-pr\.{{ .PR }}\.'
{{- else }}
    tag: "{{ .Version }}"
{{- end }}
  certSecretRef:
    name: {{ .App }}-oci-ca
