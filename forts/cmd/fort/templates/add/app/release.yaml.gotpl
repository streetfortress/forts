# {{ .App }} — HelmRelease rendered by `fort add` from the chart's contract:
# the `wire:` values paths are filled from the fort's providers by
# convention{{ if .Postgres }} (postgres → the shared sites-db, tenant `{{ .App }}`){{ end }}{{ if .Valkey }}{{ if .Postgres }};{{ end }}
# (valkey → the shared valkey, ACL user `{{ .App }}`, db{{ .Valkey.DB }}){{ end }}; password-class
# keys ride the {{ .SecretName }} Secret. Retry forever: the first install
# races its providers (and a preview pin races the images) — never park
# on a failed release waiting for an ops nudge. Refine in place after
# add: replicas for the node shape, non-secret env as values (never in
# the Secret — a values change rolls pods), app-specific knobs.
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: {{ .App }}
  namespace: {{ .App }}
spec:
  interval: 1h
  releaseName: {{ .App }}
  chartRef:
    kind: OCIRepository
    name: {{ .App }}
    namespace: flux-system
  install:
    remediation:
      retries: -1
  upgrade:
    remediation:
      retries: -1
  values:
{{ .ValuesYAML }}
