apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
{{- if .Lab }}
  - cluster-issuer-step-ca.yaml
{{- end }}
  - gateway.yaml
  - redirect-https.yaml
  - certificate-{{ .App }}.yaml
{{ .GatewayPatchesComment -}}
patches:
  - path: listener-{{ .App }}.yaml
    target:
      group: gateway.networking.k8s.io
      version: v1
      kind: Gateway
      name: homelab
      namespace: traefik
