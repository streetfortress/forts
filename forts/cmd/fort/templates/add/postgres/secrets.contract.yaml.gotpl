# Provider contract (docs/forts/fort-configuration-contracts.md) — NON-SECRET, rendered from the
# fort CLI's sites-db template (there is no chart of ours to carry it);
# provisioning/seed-secrets.py executes it until `fort seed` lands.
# Cross-cluster sops refs are fine: the admin key decrypts the source,
# the output encrypts to THIS fort's recipients. Each tenant registration
# appends its secrets-<app>.sops.yaml entry at the end.
vars:
  # luxor's rustfs root credentials (the thanos/loki precedent — no
  # per-consumer S3 users yet; the s3 provider's credential model is the
  # open question in docs/forts/fort-configuration-contracts.md).
  s3_access_key: {sops: [../../luxor/rustfs/secrets.sops.yaml, stringData.RUSTFS_ACCESS_KEY]}
  s3_secret_key: {sops: [../../luxor/rustfs/secrets.sops.yaml, stringData.RUSTFS_SECRET_KEY]}
secrets:
  secrets-backup.sops.yaml:
    metadata:
      name: sites-db-backup-credentials
      namespace: sites-db
    keys:
      ACCESS_KEY_ID: {template: "${s3_access_key}"}
      ACCESS_SECRET_KEY: {template: "${s3_secret_key}"}
{{ .TenantContractEntry -}}
