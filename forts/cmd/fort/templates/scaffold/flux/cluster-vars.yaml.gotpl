# Per-cluster identity for the shared flux/infrastructure layer (#99).
# Applied by the flux-system root sync (this dir is the FluxInstance sync
# path) and referenced via postBuild.substituteFrom on the infra-controllers,
# infrastructure and apps Kustomizations. MESH_IP must stay in sync with
# mesh/peers.json.
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-vars
  namespace: flux-system
data:
  CLUSTER_NAME: {{ .Hostname }}
  MESH_IP: {{ .MeshIP }}
