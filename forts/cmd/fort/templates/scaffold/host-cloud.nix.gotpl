# {{ .Hostname }} — single-node k3s on a {{ .Provider }} VPS ({{ .Region }},
# {{ .InstanceType }}).
#
# GENERATED by `fort scaffold {{ .Hostname }}` from
# provisioning/inventory.yaml. Scaffolding never overwrites this file —
# inventory seeds the host, you refine it here.
#
# Built as a Linode image via the upstream framework (#95/#42) — the flake
# exposes it as `{{ .Hostname }}-linode` (the linode-runtime import below
# says which variant). Root filesystem, bootloader (GRUB + LISH serial),
# eth0 DHCP, and swap on /dev/sdb all come from upstream's linode-config.nix
# via modules/linode-runtime.nix — no hand-written hardware.nix and no
# static-LAN block.
{{ if .Production -}}
#
# PRODUCTION PROFILE (production: true in inventory): SSH answers on the
# wireguard mesh address ONLY — reach it as `deployer@{{ .WgVpnIP }}`,
# not the public IP. No steven, no home stack, no wheel; see
# modules/production.nix. Public surface is the {{ .Provider }} cloud firewall
# (default-deny + 80/443 + wireguard, forts/pulumi) in front of the host's
# own firewall. Break-glass is Lish in the Linode console.
{{- else -}}
#
# Reachable as `steven` over SSH (keys from modules/interactive.nix); the
# {{ .Provider }} cloud firewall (forts/pulumi) fronts the host's own.
{{- end }}
{ lib, ... }:

{
  imports = [
    # Linode runtime contract (upstream linode-config.nix, by-label devices)
    # — declares sfi.platform = "linode", which is how the flake knows to
    # build `{{ .Hostname }}-linode`.
    ../../modules/linode-runtime.nix
    # Role modules — the host dir is self-describing so the flake stays uniform
    # and needs no per-host edit when a new host is added via inventory.
    ./secrets.nix
    ../../modules/k3s-server.nix
{{- if .HasWg }}
    ../../modules/wireguard.nix    # mesh member (wg_vpn_ip set in inventory)
{{- end }}
{{- if .Production }}
    # Hardened slim profile (#86): `deployer` account, mesh-only SSH, no
    # home stack. Replaces interactive.nix + dotfiles.nix — steven does not
    # exist on a production node.
    ../../modules/production.nix
{{- else }}
    ../../modules/interactive.nix  # steven's account (was in common.nix)
    ../../modules/dotfiles.nix     # clone ~/.files from the internal gitea over
                                   # TLS (lab CA trusted via k3s-server.nix)
{{- end }}
{{- if .FluxCluster }}
    # Day-0 flux (flux_cluster: true in inventory): fort scaffold rendered
    # fleet/clusters/{{ .Hostname }}/ and the identity pre-seed put
    # flux-sops-age-key + flux-git-deploy-key into this host's sops file.
    ../../modules/flux-bootstrap.nix
    ../../modules/auto-rebuild.nix # pull-based OS updates (#93)
{{- else }}
    # Uncomment for a flux-managed cluster node once fleet/clusters/<name>/
    # exists and the host's sops file carries flux-sops-age-key +
    # flux-git-deploy-key (see modules/flux-bootstrap.nix header) — or set
    # flux_cluster: true in inventory and re-scaffold to automate that.
    # ../../modules/flux-bootstrap.nix
{{- end }}
  ];

  networking.hostName = "{{ .Hostname }}";

  # Upstream linode-config.nix sets PermitRootLogin = "prohibit-password"
  # at normal priority, colliding with common.nix's "no" — ours wins:
  # root never logs in, Lish is the break-glass.
  services.openssh.settings.PermitRootLogin = lib.mkForce "no";
{{ if .HasWg }}
  # Cloud host, no LAN — .lofi resolution follows the wiring web3 proved:
  # split-DNS routes ~lofi over the tunnel to the lab dnsmasq's mesh
  # listener on soundship; gitea.zen.lofi is pinned so containerd pulls
  # and the flux-bootstrap clone survive the dnsmasq being down (single
  # answer — the dual-A ambiguity bit fluent-bit in #119). The in-cluster
  # half is coredns-custom. (Both come from modules/lab-dns.nix.)
  services.resolved.enable = true;
  networking.wg-quick.interfaces.wg0.dns = [ "10.1.0.1" "~lofi" ];
{{ end }}
{{- if .FluxCluster }}
  sfi.flux-bootstrap = {
    enable = true;
    cluster = "{{ .Hostname }}";
  };

  # Watch main; a changed host config lands within ~6h — or now, via
  # `sudo sfi-nixos-rebuild` (#93).
  sfi.auto-rebuild.enable = true;
{{ else }}
  # sfi.flux-bootstrap = {
  #   enable = true;
  #   cluster = "{{ .Hostname }}";
  # };
{{ end }}
  # 4 GB-SKU parity with staging-k3s, both proven there 2026-09-11/12:
  # sqlite datastore instead of embedded etcd (#164 — k3s-server with
  # etcd was 1.3 GB of the node; sqlite→etcd migrates in place later if
  # an HA join ever happens, the reverse does not; k3s_cluster_init in
  # inventory)…
  services.k3s.clusterInit = {{ if .ClusterInit }}true{{ else }}false{{ end }};

  # …and zram swap (#163): swapless 4 GB nodes hit page-cache thrash as
  # a cliff (memory PSI full-stalls while the kernel re-reads evicted
  # program text; kubelet never sees MemoryPressure). Compressed swap in
  # RAM makes it gradual and observable. Note upstream linode-config.nix
  # also mounts /dev/sdb as disk swap — zram's higher priority wins
  # while it has room, the disk tier catches overflow.
  zramSwap = {
    enable = true;
    memoryPercent = 50;
  };
  boot.kernel.sysctl = {
    # zram tunings: swap is now cheaper than a disk round-trip, so swap
    # aggressively instead of shredding page cache…
    "vm.swappiness" = 180;
    # …and don't readahead swap pages (no seek penalty on zram).
    "vm.page-cluster" = 0;
  };

  # sops wiring is in ./secrets.nix: it points defaultSopsFile at
  # secrets/{{ .Hostname }}.yaml and decrypts via the pre-seeded SSH host
  # key (age.sshKeyPaths) injected into the image before first boot.
  # Secrets are split per-host, so this host only declares the keys it
  # actually carries — no declared-but-absent secrets to fail activation.

  system.stateVersion = "{{ .StateVersion }}";
}
