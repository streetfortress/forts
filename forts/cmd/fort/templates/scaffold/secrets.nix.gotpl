# sops-nix wiring for {{ .Hostname }}: decrypts secrets/{{ .Hostname }}.yaml
# with the age key derived from this host's SSH ed25519 host key
# ({{ if .Cloud }}generated by the identity pre-seed and injected into the image before
# upload — the host never generates its own{{ else }}generated on first boot; the
# recipient is derived by fort mint{{ end }}). k3s-token is
# declared by modules/k3s-server.nix{{ if .HasWg }}; wireguard-private-key (declared
# below) is consumed by modules/wireguard.nix{{ end }}.
#
# GENERATED by `fort scaffold {{ .Hostname }}` (only when absent).
{ ... }:

{
  sops = {
    defaultSopsFile = ../../secrets/{{ .Hostname }}.yaml;
    age.sshKeyPaths = [ "/etc/ssh/ssh_host_ed25519_key" ];
{{- if .HasWg }}

    secrets.wireguard-private-key = {
      mode = "0400";
      owner = "root";
    };
{{- end }}
  };
}
