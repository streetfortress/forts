# sops-nix wiring for {{ .Hostname }}: decrypts secrets/{{ .Hostname }}.yaml
# with the age key derived from this host's SSH ed25519 host key
# ({{ if .Cloud }}minted by fort mint and placed by the initrd from the Linode Metadata
# channel before activation (modules/seed.nix, #606) — the host never
# generates its own{{ else if eq .Provider "libvirt" }}minted by fort mint and placed by the initrd from the NoCloud
# cidata volume before activation (modules/seed.nix, #657) — the host never
# generates its own{{ else }}minted by fort mint and grafted into the image by
# fort image, until the NoCloud stick lands (#658){{ end }}). {{ if .Dev }}No k3s-token: a dev
# fort has no cluster. wireguard-private-key{{ else }}k3s-token is
# declared by modules/k3s-server.nix; wireguard-private-key{{ end }} (declared
# below) is consumed by modules/wireguard.nix.
#
# GENERATED by `fort scaffold {{ .Hostname }}` (only when absent).
{ ... }:

{
  sops = {
    defaultSopsFile = ../../secrets/{{ .Hostname }}.yaml;
    age.sshKeyPaths = [ "/etc/ssh/ssh_host_ed25519_key" ];

    secrets.wireguard-private-key = {
      mode = "0400";
      owner = "root";
    };
  };
}
