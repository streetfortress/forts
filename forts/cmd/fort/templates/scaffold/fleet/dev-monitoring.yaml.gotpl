# {{ .Hostname }}'s monitoring on the hub — a DEV fort ([dev], #413): no
# cluster, no edge Prometheus, so the hub PULLS. Rendered by `fort scaffold`
# from the manifest (mesh_ip), removed by `fort dismantle`; `fort check
# --all` requires one per dev fort. Two targets over the mesh: node-exporter
# (lab-host.nix) and the fort-local OpenTelemetry collector (dev-fort.nix,
# #437) that holds Claude Code's usage metrics. The journal and the Claude
# events push to loki-mesh from the fort; this file arms the switches for
# both legs. `cluster` = the fort's name — a cluster of none, but the label
# every fleet rule and dashboard keys on.
#
# One ScrapeConfig per leg, because `job` is the CR's: the operator
# relabels job to spec.jobName AFTER the target's own labels are merged,
# so a `job:` under staticConfigs never survives (#442 — the first cut
# had one, and the series came out as job="dev_fort_<host>"). The node
# leg is job="host-node-exporter", the name a cluster fort's edge
# ServiceMonitor gives the same exporter: that job is the Host Overview
# dashboard's $host list and every panel on it (host-fleet.py), so the
# fort shows up there the moment the hub scrapes it. `component` is what
# the switches below key on; `instance` = the hostname, as on a cluster
# fort (dashboards key on names, not mesh IP:port pairs).
apiVersion: monitoring.coreos.com/v1alpha1
kind: ScrapeConfig
metadata:
  name: dev-fort-{{ .Hostname }}-node
  namespace: monitoring-central
  labels:
    monitoring.sfi/scope: central
spec:
  jobName: host-node-exporter
  staticConfigs:
    - targets: ["{{ .MeshIP }}:9100"]
      labels:
        component: node
        instance: {{ .Hostname }}
        cluster: {{ .Hostname }}
        host: {{ .Hostname }}
---
# The collector's prometheus exporter: Claude Code's usage series
# (claude_code_*), stamped cluster/host by the collector and repo/issue by
# the task's env. Same job name as the events' Loki stream (job=claude-code,
# dev-fort.nix) — one name for the one source.
apiVersion: monitoring.coreos.com/v1alpha1
kind: ScrapeConfig
metadata:
  name: dev-fort-{{ .Hostname }}-claude
  namespace: monitoring-central
  labels:
    monitoring.sfi/scope: central
spec:
  jobName: claude-code
  staticConfigs:
    - targets: ["{{ .MeshIP }}:9464"]
      labels:
        component: otel
        instance: {{ .Hostname }}
        cluster: {{ .Hostname }}
        host: {{ .Hostname }}
---
# Dead man's switch, pull-shaped: a scraped target that stops answering
# is up == 0 (no absent() needed — the series lives as long as this file).
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: dev-fort-{{ .Hostname }}
  namespace: monitoring-central
  labels:
    monitoring.sfi/scope: central
spec:
  groups:
    - name: dev-fort-{{ .Hostname }}
      rules:
        - alert: DevFortDown
          expr: up{cluster="{{ .Hostname }}", component="node"} == 0
          for: 10m
          labels:
            severity: critical
            cluster: {{ .Hostname }}
          annotations:
            summary: "{{ .Hostname }} unreachable over the mesh for 10m — fort down, or destroyed without `fort dismantle {{ .Hostname }}`"
        # The collector alone: the host answers but Claude Code's usage is
        # dark (and so is the journal leg — see LogStreamSilent).
        - alert: DevFortCollectorDown
          expr: up{cluster="{{ .Hostname }}", component="otel"} == 0 unless on (cluster) up{cluster="{{ .Hostname }}", component="node"} == 0
          for: 10m
          labels:
            severity: warning
            cluster: {{ .Hostname }}
          annotations:
            summary: "{{ .Hostname }}'s OpenTelemetry collector is not answering — Claude Code usage and the journal are not being shipped"
---
# Log analog: the journal leg (job=systemd) goes quiet. auto-rebuild's gate
# echoes into the journal every minute, so 15m of silence is a broken
# collector or ingest, not a quiet host.
apiVersion: v1
kind: ConfigMap
metadata:
  name: loki-rules-{{ .Hostname }}
  namespace: monitoring-central
  labels:
    loki_rule: "1"
data:
  {{ .Hostname }}.yaml: |
    groups:
      - name: dev-fort-{{ .Hostname }}
        rules:
          - alert: LogStreamSilent
            expr: absent_over_time({job="systemd", cluster="{{ .Hostname }}"}[15m])
            for: 5m
            labels:
              severity: warning
              cluster: {{ .Hostname }}
            annotations:
              summary: No journal from {{ .Hostname }} for 15m — the fort's collector or Loki ingest broken
