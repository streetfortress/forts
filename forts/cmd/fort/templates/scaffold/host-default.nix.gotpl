# {{ .Hostname }} — single-node k3s VM.
#
# GENERATED by `fort scaffold {{ .Hostname }}` from
# provisioning/inventory.yaml. Scaffolding never overwrites this file —
# inventory seeds the host, you refine it here.
#
# Built as a qcow2 via the upstream image framework (#95) — the flake auto-
# discovers this dir and exposes it as `{{ .Hostname }}-qcow` (the
# qcow-runtime import below says which variant). The root filesystem and
# bootloader come from qcow-runtime.nix + the qemu image variant, so there
# is no hand-written hardware.nix.
{{ if .Production -}}
# PRODUCTION PROFILE (production: true in inventory): SSH answers on the
# wireguard mesh address ONLY — reach it as `deployer@{{ .WgVpnIP }}`,
# not the LAN/public IP. No steven, no home stack, no wheel; see
# modules/production.nix.
{{- else -}}
# Reachable as `steven` over SSH (keys from modules/interactive.nix).
{{- end }}
{ ... }:

{
  imports = [
    # qcow VM runtime contract (virtio guest profile, root-by-label, grub on
    # /dev/vda, serial console) — declares sfi.platform = "qemu", which is
    # how the flake knows to build `{{ .Hostname }}-qcow`.
    ../../modules/qcow-runtime.nix
    # Role modules — the host dir is self-describing so the flake stays uniform
    # and needs no per-host edit when a new host is added via inventory.
    ./secrets.nix
    ../../modules/k3s-server.nix
{{- if .HasWg }}
    ../../modules/wireguard.nix    # mesh member (wg_vpn_ip set in inventory)
{{- end }}
{{- if .Production }}
    # Hardened slim profile (#86): `deployer` account, mesh-only SSH, no
    # home stack. Replaces interactive.nix + dotfiles.nix — steven does not
    # exist on a production node.
    ../../modules/production.nix
{{- else }}
    ../../modules/interactive.nix  # steven's account (was in common.nix)
    ../../modules/dotfiles.nix     # clone ~/.files from the internal gitea over
                                   # TLS (lab CA trusted via k3s-server.nix)
{{- end }}
{{- if .FluxCluster }}
    # Day-0 flux (flux_cluster: true in inventory): cluster-init scaffolded
    # fleet/clusters/{{ .Hostname }}/ and seeded flux-sops-age-key +
    # flux-git-deploy-key into this host's sops file.
    ../../modules/flux-bootstrap.nix
    ../../modules/auto-rebuild.nix # pull-based OS updates (#93)
{{- else }}
    # Uncomment for a flux-managed cluster node once fleet/clusters/<name>/
    # exists and the host's sops file carries flux-sops-age-key +
    # flux-git-deploy-key (see modules/flux-bootstrap.nix header) — or set
    # flux_cluster: true in inventory and re-scaffold to automate that.
    # ../../modules/flux-bootstrap.nix
{{- end }}
  ];

  networking.hostName = "{{ .Hostname }}";
{{ if .FluxCluster }}
  sfi.flux-bootstrap = {
    enable = true;
    cluster = "{{ .Hostname }}";
  };

  # Watch main; a changed host config lands within ~6h — or now, via
  # `sudo sfi-nixos-rebuild` (#93).
  sfi.auto-rebuild.enable = true;
{{ else }}
  # sfi.flux-bootstrap = {
  #   enable = true;
  #   cluster = "{{ .Hostname }}";
  # };
{{ end }}
  # Static address on the hypervisor's LAN bridge — matches ansible_host in
  # provisioning/inventory.yaml.
  networking.useDHCP = false;
  systemd.network.enable = true;
  systemd.network.networks."10-lan" = {
    matchConfig.Name = "en*";
    address = [ "{{ .IP }}/{{ .LanPrefix }}" ];
    gateway = [ "{{ .LanGateway }}" ];
    dns = [ {{ range $i, $d := .LanDNS }}{{ if $i }} {{ end }}"{{ $d }}"{{ end }} ];
  };

  # Single-node server with embedded etcd (server config and the k3s-token
  # requirement come from modules/k3s-server.nix). Set to false in inventory
  # (k3s_cluster_init: false) for a lean sqlite datastore instead.
  services.k3s.clusterInit = {{ if .ClusterInit }}true{{ else }}false{{ end }};

  # sops wiring is in ./secrets.nix: it points defaultSopsFile at
  # secrets/{{ .Hostname }}.yaml and decrypts via the pre-seeded SSH host key
  # (age.sshKeyPaths) injected into the image before first boot. Secrets are
  # split per-host, so this host only declares the keys it actually carries —
  # no declared-but-absent secrets to fail activation.

  system.stateVersion = "{{ .StateVersion }}";
}
